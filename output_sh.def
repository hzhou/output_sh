include: output.def
include: macros_output/case.def

page: output_sh, output_main
    type: pm
    output_dir: lib/MyDef
    ext: sh
    package: MyDef::output_sh

subcode: parsecode
    $call parsecode_case_support, if, elif, sh_style
    # $print: plain echo, no format handling
    $if $l=~/^\$print\b\s*(.*)$/
        $if $1 ne ""
            push @$out, "echo $1"
        $else
            push @$out, "echo"
        return 0
    $call @parsecode_other
    push @$out, $l
    return 0

